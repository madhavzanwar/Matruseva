# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
# Used only in Server Actions / route handlers that must bypass RLS
# (e.g. inviting staff, admin operations).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Local Supabase CLI stack (from `supabase start` output). Same shape as above,
# point NEXT_PUBLIC_SUPABASE_URL / keys at these while developing locally
# instead of the hosted project.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase start`>
# SUPABASE_SERVICE_ROLE_KEY=<from `supabase start`>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mother's public listen link ---
# Secret used to HMAC-sign the expiring /listen/<token> links sent to mothers on WhatsApp.
# REQUIRED (no default; links fail closed without it). Generate with: openssl rand -base64 32
# Rotating it invalidates all previously sent links.
LISTEN_LINK_SECRET=

# --- WhatsApp Cloud API webhook (required for /api/whatsapp/webhook; no defaults) ---
# Token you type into Meta's webhook setup screen (any long random string).
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App Settings -> Basic); used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Optional, to send replies back via the Graph API:
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Voice notes (needs the two vars above AND Gnani keys): mothers' WhatsApp voice notes are transcribed
# with Gnani Prisma and handled like typed replies. Set to 1 to ALSO answer with a spoken (Timbre) copy
# of the text reply. Off by default (costs TTS credits); text reply is always sent.
# WHATSAPP_VOICE_REPLIES=1
# STT language hint for voice notes: comma list of up to 4 codes (e.g. hi-IN,mr-IN,gu-IN,en-IN).
# Default: indic-auto (Prisma v3.0 auto-detects).
# GNANI_WA_LANGS=indic-auto

# --- Demo mode (OFF by default) ---
# Set to 1 only on a throwaway demo deployment. Enables the shared demo login and
# fake-data mode; leave unset in production.
# DEMO_MODE=1

# --- Gnani AI speech (STT / TTS) ---
# SERVER-ONLY secrets: never prefix with NEXT_PUBLIC_, never commit real keys.
# Comma-separated key pool (e.g. the 3 free keys pooled); each key is used one request at a time.
# GNANI_API_KEYS=key1,key2,key3
# ...or a single key:
# GNANI_API_KEY=
# Optional overrides (defaults shown):
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE_FEMALE=Shivani
# GNANI_TTS_VOICE_MALE=Avinash
# Kill switch: 0 disables Gnani (clients fall back to browser speech)
# GNANI_ENABLED=1
# Per-user / global guard rails against burning the credit allowance (in-memory, per instance):
# GNANI_STT_PER_MINUTE=20
# GNANI_TTS_PER_MINUTE=60
# GNANI_STT_DAILY_SECONDS_PER_USER=1800
# GNANI_TTS_DAILY_CHARS_PER_USER=30000
# GNANI_STT_DAILY_SECONDS_GLOBAL=7200
# GNANI_TTS_DAILY_CHARS_GLOBAL=200000
# Smoke test with a real key: npm run gnani:check
